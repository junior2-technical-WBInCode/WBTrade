# WBTrade API Environment Variables

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL="postgresql://wbtrade:wbtrade_secret@localhost:5432/wbtrade?schema=public"

# ===========================================
# REDIS
# ===========================================
REDIS_URL="redis://localhost:6379"

# ===========================================
# MEILISEARCH
# ===========================================
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="wbtrade_meili_key_change_in_production"

# ===========================================
# JWT SECRETS
# ===========================================
JWT_ACCESS_SECRET="dev_access_secret_wbtrade_2024_change_in_production"
JWT_REFRESH_SECRET="dev_refresh_secret_wbtrade_2024_change_in_production"

# ===========================================
# APPLICATION
# ===========================================
NODE_ENV="development"
APP_PORT=5000
FRONTEND_URL="http://localhost:3000"

# ===========================================
# EMAIL SERVICE (MailHog for development)
# ===========================================
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="WBTrade <noreply@wbtrade.pl>"

# ===========================================
# PAYMENT PROVIDERS (empty for development)
# ===========================================
P24_MERCHANT_ID=""
P24_API_KEY=""
P24_CRC_KEY=""

# ===========================================
# SHIPPING PROVIDERS (empty for development)
# ===========================================
INPOST_API_KEY=""
DPD_API_KEY=""
DPD_API_SECRET=""
DHL_API_KEY=""
GLS_API_KEY=""

# ===========================================
# BASELINKER INTEGRATION
# ===========================================
BASELINKER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
BASELINKER_DEFAULT_INVENTORY_ID=""

# ===========================================
# FAKTUROWNIA - COLLECTIVE B2B INVOICES
# ===========================================
FAKTUROWNIA_DOMAIN="wb-incodetest"
FAKTUROWNIA_API_TOKEN=""

# ===========================================
# LOGO DEV
# ===========================================
NEXT_PUBLIC_LOGO_DEV_API_KEY=pk_QYRkk2WuRCWPHmEKm9hlig

# ===========================================
# PAYU
# ===========================================
PAYU_POS_ID=""
PAYU_CLIENT_ID=""
PAYU_CLIENT_SECRET=""
PAYU_SECOND_KEY=""
# PAYU_SANDBOX: jeśli USTAWIONE, ma pierwszeństwo nad NODE_ENV.
#   "true"  => sandbox (secure.snd.payu.com), karty testowe, brak realnych płatności
#   "false" => PRODUKCJA (secure.payu.com) — UWAGA: REALNE PIENIĄDZE, także lokalnie!
#   nieustawione => sandbox poza produkcją (NODE_ENV != production)
# NIGDY nie trzymaj produkcyjnych danych PayU w deweloperskim .env.
PAYU_SANDBOX="true"

# ===========================================
# PROGRAM PARTNERSKI / AFILIACJA
# ===========================================
# Bazowa prowizja partnera w % od wartości brutto po rabacie (domyślnie 5.00)
AFFILIATE_DEFAULT_COMMISSION_RATE="7.00"
# Karencja w dniach: PAID -> APPROVED (domyślnie 14)
AFFILIATE_HOLD_DAYS="14"
# Minimalna kwota wypłaty gotówkowej
AFFILIATE_MIN_CASH_PAYOUT="50"
# Prefiks kodu kuponu wypłaty
AFFILIATE_COUPON_PREFIX="REF"
# Uwaga: 2-tier MLM (AFFILIATE_PARENT_COMMISSION_RATE) jest ODŁOŻONE (Faza 3, ryzyko UOKiK) — nieużywane.